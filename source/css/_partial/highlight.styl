code-font-size = 16px
code-font-family = 'Inconsolata', 'monospace', 'Open Sans', 'Microsoft Yahei', sans-serif
$dark-mode = hexo-config('dark_mode')
$smooth-corner = hexo-config('smooth_corner')
code-border-color = rgba(0, 0, 0, 0.125)
$code-line-number = hexo-config('code.line_number')
line-number-width = 2.15em
line-number-pad = 0.55em
line-number-gap = 0.85em
line-number-gutter = line-number-width + line-number-gap
line-number-color = #a0a1a7

if ($dark-mode == false)
  @import './highlight-themes/atom-one-light'
else if ($dark-mode == true)
  @import './highlight-themes/atom-one-dark-reasonable'
else // auto
  @import './highlight-themes/atom-one-light'

  @media (prefers-color-scheme: dark)
    @import './highlight-themes/atom-one-dark-reasonable'

code, .code, .gutter, pre, figcaption
  padding: 7px
  line-height: 1.45em
  font-size: code-font-size
  font-family: code-font-family

figure.highlight
  margin: 1em 0
  box-shadow: 1px 1px 2px 2px rgba(0, 0, 0, 0.125)
  border-radius: 5px

  if ($dark-mode == false)
    @import './highlight-themes/atom-one-light'
  else if ($dark-mode == true)
    @import './highlight-themes/atom-one-dark-reasonable'
  else // auto
    @import './highlight-themes/atom-one-light'

    &
      @extend .hljs

    @media (prefers-color-scheme: dark)
      @import './highlight-themes/atom-one-dark-reasonable'

      &
        @extend .hljs

  if ($smooth-corner)
    smooth-corner(5, 5, 5)

  table
    display: block
    position: relative
    margin: 0 !important
    overflow-x: visible

    .code
      padding: 0

      if ($smooth-corner)
        padding-right: 1em

      pre
        margin: 0
        // keep the first line clear of the copy button
        padding: 7px 64px 7px 0
        counter-reset: line
        border-radius: 5px 0 0 5px

        @media (max-width: 768px)
          padding-right: 7px

        if ($code-line-number)
          background-image: linear-gradient(to right, code-border-color 0, code-border-color line-number-width, transparent line-number-width)

        br
          display: none

        .line
          display: block
          position: relative
          min-height: 1.45em
          white-space: pre-wrap
          overflow-wrap: anywhere

          if ($code-line-number)
            padding-left: line-number-gutter
            counter-increment: line

            &:before
              content: counter(line)
              position: absolute
              left: 0
              top: 0
              box-sizing: border-box
              width: line-number-width
              padding-right: line-number-pad
              text-align: right
              user-select: none
              text-color(line-number-color, line-number-color, #b18eb1)

    .gutter
      display: none

  & > .clipboard-btn
    border: 1px solid
    border-color(code-border-color, code-border-color, code-border-color)

    &[data-clicked=true]
      .icon:before
        @extend .icon-clipboard-check:before

    @media (max-width: 768px)
      display: none

    position: absolute
    top: 0
    right: 0
    display: flex
    align-items: center
    justify-content: center
    width: 1.2 * content-font-size
    height: 1.2 * content-font-size
    padding: 0.25em
    margin: 10px 1em
    border-radius: 5px

    if ($smooth-corner)
      smooth-corner(5, 5, 100)

    border-color(primary-gray, primary-gray-light, primary-gray-dark)
    background-color($background-color, background-color-light, background-color-dark)
    cursor: pointer

    .icon:before
      @extend .icon-clipboard:before
      font-size: content-font-size

    &:hover
      background-color(primary-gray, primary-gray-light, primary-gray-dark)

      .icon
        text-color(primary-color, primary-color-light, primary-color-dark)

  table, tr
    margin: 0
    padding: 0
    width: 100%
    border-collapse: collapse

  // If has a caption
  figcaption
    padding-caption = 1em
    padding-x = 2 * padding-caption
    user-select: none
    border-radius: 5px 5px 0 0
    border-bottom: 1px solid
    border-color(code-border-color, code-border-color, code-border-color)

    font-weight: normal
    display: grid
    grid-template-columns: 1fr auto auto
    column-gap: 1em
    justify-items: start
    width: 'calc(100% - %s)' % padding-x
    padding: 0.5em padding-caption 0.25em padding-caption
    margin: 0

    @extend .comment

    @media (max-width: 768px)
      display: none

    .clipboard-btn
      cursor: pointer

    & + table
      .code pre
        border-radius: 0 0 0 5px

  &.c
    figcaption
      span
        &:before
          content: '/* '
        &:after
          content: ' */'

  &.cpp
    figcaption
      span
        &:before
          content: '// '
